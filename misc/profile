export PATH=$PATH:$HOME/git/bin/:/bin:/sbin:/usr/bin:/usr/sbin:/usr/X11R6/bin:/usr/local/bin:/usr/local/sbin:$HOME/.local/bin
export HOME TERM
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export MOZ_ACCELERATED=1
export MOZ_WEBRENDER=1
export HISTSIZE=10000
export ENV=$HOME/git/rules/rc
export HISTFILE=$HOME/git/rules/history

export KISS_HOOK=$HOME/git/bin/kiss-hook
export KISS_PATH=''                                              
KISS_PATH=$KISS_PATH:$HOME/git/kiss-repo/wayland
KISS_PATH=$KISS_PATH:$HOME/git/kiss-repo/core
KISS_PATH=$KISS_PATH:$HOME/git/kiss-repo/extra

export CFLAGS="-O3 -pipe -march=native"
export CXXFLAGS="$CFLAGS"
export MAKEFLAGS="-j26"

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/$(id -u)-runtimedir}

[ -d "$XDG_RUNTIME_DIR" ] || {
    mkdir -p   "$XDG_RUNTIME_DIR"
    chmod 0700 "$XDG_RUNTIME_DIR"
}
